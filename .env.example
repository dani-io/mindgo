# ═══════════════════════════════════════
# Mindgo — Environment Variables
# Copy this file to .env.local and fill in
# ═══════════════════════════════════════

# ── Database ──
DATABASE_URL="postgresql://user:password@localhost:5432/mindgo_db"

# ── Auth ──
NEXTAUTH_SECRET="generate-a-secret-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
JWT_EXPIRY="24h"

# ── Kavenegar (SMS/OTP) ──
KAVENEGAR_API_KEY=""
KAVENEGAR_SENDER=""
KAVENEGAR_OTP_TEMPLATE="verify-otp"
# Comma-separated phones that always receive the OTP code in the API response (test/demo mode).
# In non-production environments ALL phones get the code. Remove when Kavenegar is connected.
TEST_PHONES="09179498400,09121111111,09122222222"

# ── ZarinPal (Payment Gateway) ──
ZARINPAL_MERCHANT_ID=""
ZARINPAL_CALLBACK_URL="http://localhost:3000/api/webhooks/zarinpal"
ZARINPAL_SANDBOX=true

# ── SnappPay (Installment Payment) ──
SNAPPAY_API_KEY=""
SNAPPAY_CALLBACK_URL="http://localhost:3000/api/webhooks/snappay"

# ── Email (Najva) ──
NAJVA_API_KEY=""

# ── Jitsi Meet ──
JITSI_DOMAIN="meet.jit.si"
JITSI_APP_ID=""

# ── Google Calendar Sync ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── File Upload (Liara Object Storage — S3-compatible) ──
S3_ENDPOINT="https://storage.iran.liara.space"
S3_BUCKET="mindgo-storage"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="us-east-1"
# Public URL prefix for uploaded files (defaults to S3_ENDPOINT/S3_BUCKET if not set)
NEXT_PUBLIC_S3_PUBLIC_URL="https://storage.iran.liara.space/mindgo-storage"

# ── Platform Settings ──
DEFAULT_COMMISSION_RATE=0.70
MIN_PAYOUT_AMOUNT=500000
SESSION_AUTO_CONFIRM_HOURS=24
PAYOUT_DAY="monday"

# ── App ──
NEXT_PUBLIC_APP_NAME="Mindgo"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_DOMAIN="mindgo.ir"
